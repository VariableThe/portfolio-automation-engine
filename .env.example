# ==============================================================================
# Portfolio Automation Engine Environment Configuration
# ==============================================================================

# ── Broker Credentials ────────────────────────────────────────────────────────
# Set BROKER_TYPE to 'zerodha' for Kite Connect live trading, or 'mock' for simulated trading.
BROKER_TYPE=mock

# Zerodha Kite Connect API Credentials (Required if BROKER_TYPE=zerodha)
# Example: BROKER_API_KEY=abc123xyz456
BROKER_API_KEY=your_zerodha_api_key_here
BROKER_API_SECRET=your_zerodha_api_secret_here
BROKER_USER_ID=AB1234
# Access token generated after daily Zerodha OAuth login flow
BROKER_ACCESS_TOKEN=your_daily_kite_access_token_here

# ── Notification Channels ─────────────────────────────────────────────────────
# Discord Webhook URL for real-time trade alerts and safety gate triggers
# Example: DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdef...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abc_example_token

# Telegram Bot Token and Chat ID for instant push notifications
# Example: TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=123456789:ABC_example_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# ── Security & Authentication ─────────────────────────────────────────────────
# Secret API key required for sensitive dashboard actions (Kill Switch, Manual Approvals)
DASHBOARD_API_KEY=change-this-to-a-secure-secret-key-in-production

# ── Database Persistence ──────────────────────────────────────────────────────
# Path to the SQLite database file inside container or local workspace
DATABASE_PATH=data/portfolio.db
